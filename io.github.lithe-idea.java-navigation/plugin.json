{
  "schemaVersion": 0,
  "id": "io.github.lithe-idea.java-navigation",
  "displayName": "Java Support Lite",
  "version": "0.2.1",
  "pluginAPIVersion": 0,
  "requires": {
    "backend": 0,
    "languageServers": 0,
    "languages": 0
  },
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": [
    "backend.launch",
    "documents.read",
    "editor.actions",
    "languageServer.launch",
    "languageServer.request",
    "workspace.metadata"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onWorkspaceOpen"
  ],
  "languages": [
    {
      "id": "java",
      "displayName": "Java",
      "fileExtensions": [
        "java"
      ],
      "projectFileNames": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts"
      ]
    }
  ],
  "languageServers": [
    {
      "languageID": "java",
      "languageIdentifier": "java",
      "launch": {
        "kind": "packaged",
        "path": "bin/java-navigation"
      },
      "arguments": [
        "--state-dir",
        "${stateDir}"
      ],
      "validationArguments": [
        "--version"
      ],
      "requestMethods": [
        "textDocument/implementation",
        "javaNavigation/superDeclarations",
        "javaNavigation/markers"
      ]
    }
  ],
  "backend": {
    "launch": {
      "kind": "packaged",
      "path": "bin/java-navigation"
    },
    "arguments": [
      "--backend"
    ]
  }
}
